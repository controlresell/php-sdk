{
    "name": "controlresell/sdk",
    "description": "PHP SDK for the ControlResell public API.",
    "type": "library",
    "keywords": ["controlresell", "vinted", "resale", "api", "sdk"],
    "homepage": "https://github.com/controlresell/php-sdk",
    "license": "Apache-2.0",
    "authors": [
        { "name": "ControlResell", "homepage": "https://controlresell.com" }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": { "ControlResell\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "ControlResell\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
